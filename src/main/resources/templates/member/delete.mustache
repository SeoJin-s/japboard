<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>회원 탈퇴</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9fa;
      font-family: 'Pretendard', sans-serif;
    }
    .delete-container {
      max-width: 500px;
      margin: 100px auto;
      background-color: #fff;
      padding: 40px;
      border-radius: 12px;
      box-shadow: 0 0 10px rgba(0,0,0,0.05);
      text-align: center;
    }
    .delete-title {
      font-size: 22px;
      font-weight: 600;
      margin-bottom: 20px;
    }
    .btn-area {
      display: flex;
      justify-content: space-around;
      margin-top: 20px;
    }
  </style>
</head>
<body>

  <div class="delete-container">
    <div class="delete-title">회원 탈퇴</div>
    
    <form id="deleteForm" action="/member/delete" method="post">
      <p>정말 탈퇴하시겠습니까?<br>탈퇴 시 계정 정보는 복구되지 않습니다.</p>

      <div class="btn-area">
        <button type="submit" class="btn btn-danger">탈퇴하기</button>
        <a href="/member/myPage" class="btn btn-outline-secondary">취소</a>
      </div>
    </form>
  </div>

  <script>
    // form의 submit 이벤트를 직접 연결
    document.getElementById("deleteForm").addEventListener("submit", function(event) {
      const confirmResult = confirm("정말로 회원 탈퇴하시겠습니까?\n되돌릴 수 없습니다.");
      if (!confirmResult) {
        event.preventDefault(); // 전송 막기
      }
    });
  </script>

</body>
</html>
