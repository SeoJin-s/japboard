<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>마이페이지</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f1f3f4;
      font-family: 'Pretendard', sans-serif;
    }
    .mypage-container {
      max-width: 480px;
      margin: 60px auto;
      background: #fff;
      padding: 40px 30px;
      border-radius: 20px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }
    .profile-img {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background-image: url('https://via.placeholder.com/80'); 
      background-size: cover;
      background-position: center;
      margin: 0 auto;
    }
    .welcome-msg {
      font-size: 20px;
      font-weight: 600;
      text-align: center;
      margin-top: 15px;
    }
    .btn-block {
      width: 100%;
      margin-top: 10px;
    }
    .section-title {
      font-size: 14px;
      color: #888;
      margin-top: 30px;
      margin-bottom: 10px;
    }
  </style>
</head>
<body>

  <div class="mypage-container text-center">
  <img src="/images/winter.png" alt="프로필"
       class="rounded-circle shadow-sm mb-3"
       style="width: 100px; height: 100px; object-fit: cover;">

  <div class="welcome-msg">안녕하세요, <strong>{{loginName}}</strong>님.</div>
  <div class="text-muted small">계정 정보를 관리하세요.</div>

  <!-- 버튼 영역 -->
  <div class="d-grid gap-2 mt-4">
    <a href="/member/update" class="btn btn-primary btn-block">회원정보 수정</a>

    <form action="/member/delete" method="post" onsubmit="return confirm('정말 탈퇴하시겠습니까? 😢');">
      <button type="submit" class="btn btn-outline-danger btn-block">회원탈퇴</button>
    </form>

    <a href="/member/memberList" class="btn btn-outline-secondary btn-block">전체 회원 보기</a>
    <a href="/" class="btn btn-light btn-block">홈으로 돌아가기</a>
  </div>
</div>

</body>
</html>
