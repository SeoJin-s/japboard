<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>비밀번호 변경</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9fa;
      font-family: 'Pretendard', sans-serif;
    }
    .update-container {
      max-width: 500px;
      margin: 100px auto;
      background-color: #fff;
      padding: 40px;
      border-radius: 12px;
      box-shadow: 0 0 10px rgba(0,0,0,0.05);
    }
    .update-title {
      font-size: 22px;
      font-weight: 600;
      margin-bottom: 20px;
      text-align: center;
    }
  </style>
</head>
<body>
  <div class="update-container">
    <div class="update-title">비밀번호 변경</div>

    {{#msg}}
    <div class="alert alert-success text-center">{{msg}}</div>
    {{/msg}}

    <form action="/member/update" method="post">
      <div class="mb-3">
        <label for="memberPw" class="form-label">새 비밀번호</label>
        <input type="password" class="form-control" id="memberPw" name="memberPw" required>
      </div>
      <div class="text-center">
        <button type="submit" class="btn btn-primary w-100">비밀번호 변경</button>
      </div>
    </form>
  </div>
</body>
</html>
