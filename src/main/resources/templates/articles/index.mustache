<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>게시글 목록 | JPABoard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css" rel="stylesheet">
  <style>
    body {
      background-color: #f5f5f5;
      font-family: 'Pretendard', sans-serif;
    }

    .article-container {
      max-width: 960px;
      margin: 80px auto;
      background-color: #ffffff;
      padding: 40px;
      border-radius: 12px;
      box-shadow: 0 0 10px rgba(0,0,0,0.03);
    }

    .article-title {
      font-size: 26px;
      font-weight: 600;
      margin-bottom: 30px;
      color: #111;
    }

    .search-form {
      margin-bottom: 20px;
    }

    .search-form input {
      width: 200px;
    }

    .pagination-box {
      text-align: center;
      margin-top: 20px;
      font-size: 14px;
    }

    .btn-dark {
      background-color: #000;
      border: none;
    }

    .btn-dark:hover {
      background-color: #333;
    }

    .table a {
      color: #000;
      font-weight: 500;
      text-decoration: none;
    }

    .table a:hover {
      text-decoration: underline;
    }

    .new-article-link {
      float: right;
      margin-top: 20px;
    }

    .msg-box {
      margin-bottom: 15px;
      color: #c0392b;
      font-weight: 500;
    }
  </style>
</head>
<body>
{{>layouts/header}}

<div class="article-container">
  <h2 class="article-title">📰 Article 목록</h2>

  {{#msg}}
    <div class="msg-box">{{msg}}</div>
  {{/msg}}

  <form action="/articles/index" method="get" class="search-form d-flex">
    <input type="text" name="word" class="form-control" placeholder="검색어 입력">
    <button type="submit" class="btn btn-dark ms-2">검색</button>
  </form>

  <table class="table table-hover text-center align-middle">
    <thead class="table-light">
      <tr>
        <th style="width:10%;">ID</th>
        <th style="width:30%;">제목</th>
        <th style="width:60%;">내용</th>
      </tr>
    </thead>
    <tbody>
      {{#list}}
        <tr>
          <td>{{id}}</td>
          <td>
            <a href="/articles/show?id={{id}}">{{title}}</a>
          </td>
          <td>{{content}}</td>
        </tr>
      {{/list}}
    </tbody>
  </table>

  <div class="pagination-box">
    {{^list.isFirst}}
      <a href="/articles/index?currentPage={{prePage}}" class="me-3">← 이전</a>
    {{/list.isFirst}}

    페이지 <strong>{{list.getNumber}}</strong>

    {{#list.hasNext}}
      <a href="/articles/index?currentPage={{nextPage}}" class="ms-3">다음 →</a>
    {{/list.hasNext}}
  </div>

  <a href="/articles/new" class="btn btn-dark new-article-link">글쓰기</a>
</div>

{{>layouts/footer}}
</body>
</html>
