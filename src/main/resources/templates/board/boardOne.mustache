<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>{{board.boardTitle}} - 상세보기</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
{{>layouts/header}}

<h2 class="mt-4 mb-3">📄 게시글 상세보기</h2>

<table class="table table-bordered">
  <thead>
    <tr>
      <th scope="col">번호</th>
      <th scope="col">제목</th>
      <th scope="col">내용</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>{{board.no}}</td>
      <td>{{board.boardTitle}}</td>
      <td>{{board.boardContent}}</td>
    </tr>
  </tbody>
</table>

<div class="mt-3">
    <a href="/board/list" class="btn btn-secondary">목록으로</a>
	<a href="/board/modify/{{board.no}}" class="btn btn-warning">수정</a>
  	<form action="/board/delete/{{board.no}}" method="post" class="d-inline">
      <button type="submit" class="btn btn-danger" onclick="return confirm('정말 삭제하시겠습니까?')">삭제</button>
	</form>
</div>

{{>layouts/footer}}
</body>
</html>
