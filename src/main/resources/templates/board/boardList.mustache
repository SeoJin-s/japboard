<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8">
	<title>Insert title here</title>
	<!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

</head>
<body>
{{>layouts/header}}

<h2>📋 게시글 목록</h2>

<form method="get" action="/board/boardList">
  <input type="text" name="word" value="{{word}}" placeholder="검색어">
  <button type="submit">검색</button>
</form>

<table class="table mt-3">
  <thead>
    <tr>
      <th>번호</th>
      <th>제목</th>
      <th>내용</th>
    </tr>
  </thead>
  <tbody>
    {{#list.content}}
    <tr>
       	  <td>{{boardNo}}</td>
		  <td>
		  <a href="/board/{{boardNo}}">
		    {{boardTitle}}
		  </a>
		</td>
		  <td>{{boardContent}}</td>
    </tr>
    {{/list.content}}
  </tbody>
</table>

<div>
  {{^list.first}}<a href="?currentPage={{prePage}}&word={{word}}">이전</a>{{/list.first}}
  <span>페이지 {{list.number}} / {{list.totalPages}}</span>
  {{#list.hasNext}}<a href="?currentPage={{nextPage}}&word={{word}}">다음</a>{{/list.hasNext}}
</div>

<a href="/board/addBoard" class="btn btn-primary">글쓰기</a>

{{>layouts/footer}}
</body>
</html>