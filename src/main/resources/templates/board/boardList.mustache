<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>게시글 목록 | JPABoard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css" rel="stylesheet">
  <style>
    body {
      background-color: #f5f5f5;
      font-family: 'Pretendard', sans-serif;
    }

    .board-container {
      max-width: 960px;
      margin: 80px auto;
      background: #fff;
      padding: 40px;
      border-radius: 12px;
      box-shadow: 0 0 10px rgba(0,0,0,0.03);
    }

    .board-title {
      font-size: 26px;
      font-weight: bold;
      margin-bottom: 30px;
      color: #111;
    }

    .search-box {
      margin-bottom: 25px;
    }

    .search-box input {
      width: 200px;
      display: inline-block;
    }

    table th {
      font-weight: 600;
      background-color: #f8f9fa;
    }

    table td, table th {
      vertical-align: middle;
    }

    .pagination-box {
      margin-top: 20px;
      text-align: center;
      font-size: 14px;
    }

    .btn-primary {
      background-color: #000;
      border: none;
    }

    .btn-primary:hover {
      background-color: #333;
    }

    .btn-write {
      float: right;
      margin-top: 20px;
    }
  </style>
</head>
<body>
{{>layouts/header}}

<div class="board-container">
  <h2 class="board-title">📋 게시글 목록</h2>

  <form method="get" action="/board/boardList" class="search-box">
    <input type="text" class="form-control d-inline-block" name="word" value="{{word}}" placeholder="검색어">
    <button type="submit" class="btn btn-dark ms-2">검색</button>
  </form>

  <table class="table table-hover text-center align-middle">
    <thead>
      <tr>
        <th style="width:10%;">번호</th>
        <th style="width:30%;">제목</th>
        <th style="width:60%;">내용</th>
      </tr>
    </thead>
    <tbody>
      {{#list.content}}
      <tr>
        <td>{{boardNo}}</td>
        <td>
          <a href="/board/{{boardNo}}" class="text-decoration-none text-dark fw-bold">
            {{boardTitle}}
          </a>
        </td>
        <td>{{boardContent}}</td>
      </tr>
      {{/list.content}}
    </tbody>
  </table>

  <div class="pagination-box">
    {{^list.first}}<a href="?currentPage={{prePage}}&word={{word}}" class="me-3">← 이전</a>{{/list.first}}
    <span>페이지 <strong>{{list.number}}</strong> / {{list.totalPages}}</span>
    {{#list.hasNext}}<a href="?currentPage={{nextPage}}&word={{word}}" class="ms-3">다음 →</a>{{/list.hasNext}}
  </div>

  <a href="/board/addBoard" class="btn btn-primary btn-write">글쓰기</a>
</div>

{{>layouts/footer}}
</body>
</html>
